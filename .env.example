
# MySQL database initialization

# Pass for the MySQL admin acc in the Docker container
MYSQL_ROOT_PASSWORD=change_me_to_a_local_root_password
# The db that Docker will initialize
MYSQL_DATABASE=skillbridge_ai
# The separate acc Springboot will use
MYSQL_USER=skillbridge_app
MYSQL_PASSWORD=change_me_to_a_local_app_password

# Spring Boot database connection

# Tells springboot how to reach MySQL through Docker's internal network
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/skillbridge_ai
SPRING_DATASOURCE_USERNAME=skillbridge_app
SPRING_DATASOURCE_PASSWORD=change_me_to_a_local_app_password

# Spring Boot JPA settings

# Allow Hibernate to update the database schema during development
SPRING_JPA_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
